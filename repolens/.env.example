# RepoLens Configuration
REPOLENS_DATA_DIR=.repolens
REPOLENS_DB_URL=sqlite+aiosqlite:///.repolens/repolens.db
REPOLENS_EMBEDDING_PROVIDER=ollama
REPOLENS_EMBEDDING_MODEL=nomic-embed-text
REPOLENS_OLLAMA_URL=http://127.0.0.1:11434
REPOLENS_OPENAI_API_KEY=
REPOLENS_GEMINI_API_KEY=
REPOLENS_VECTOR_BACKEND=lancedb
REPOLENS_VECTOR_PATH=.repolens/vectors
REPOLENS_SERVER_HOST=127.0.0.1
REPOLENS_SERVER_PORT=8420
REPOLENS_LOG_LEVEL=INFO
REPOLENS_MCP_WORKERS=8
REPOLENS_INDEX_WORKERS=2
REPOLENS_AUTO_INDEX_DELAY_SECONDS=600
REPOLENS_INDEX_POLL_SECONDS=2
REPOLENS_INDEX_LEASE_SECONDS=900
REPOLENS_PROMETHEUS_ENABLED=true
REPOLENS_METRICS_PORT=9090
